<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Muncipality Dashboard - Voice Municipal Assistant</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="/official/officialStyles/officialStyles.css" rel="stylesheet">
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <div class="staff-info">
                    <div class="staff-logo">👷</div>
                    <div class="staff-details">
                        <h3 id="staffName"></h3>
                        <p id="staffDept"></p>
                    </div>
                </div>
            </div>
            
                <div class="nav-menu">
                <a href="#my-tasks" class="nav-item active">
                    <i class="fas fa-tasks"></i>
                    <span class="trans" data-key="nav_my_tasks">My Tasks</span>
                </a>
                <a href="#assigned-complaints" class="nav-item">
                    <i class="fas fa-clipboard-list"></i>
                    <span class="trans" data-key="nav_assigned">Assigned Complaints</span>
                </a>
                <a href="#field-updates" class="nav-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <span class="trans" data-key="nav_field_updates">Field Updates</span>
                </a>
                <a href="#work-history" class="nav-item">
                    <i class="fas fa-history"></i>
                    <span class="trans" data-key="nav_work_history">Work History</span>
                </a>
                <a href="#resources" class="nav-item">
                    <i class="fas fa-tools"></i>
                    <span class="trans" data-key="nav_resources">Resources</span>
                </a>
                <a href="#voice-reports" class="nav-item">
                    <i class="fas fa-microphone"></i>
                    <span class="trans" data-key="nav_voice_reports">Voice Reports</span>
                </a>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Header -->
            <header class="header">
                <div class="header-left">
                    <h1>Staff Dashboard</h1>
                </div>
                
                <div class="header-right">
                    <div class="task-counter">
                        <i class="fas fa-tasks"></i>
                        5 Active Tasks
                    </div>
                    
                    <div class="user-profile">
                        <div class="user-avatar">S</div>
                        <span>Staff</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                </div>
            </header>

            <!-- Dashboard Content -->
            <div class="dashboard-content">
                <!-- Quick Stats -->
                <div class="quick-stats">
                    <div class="stat-card">
                        <div class="stat-icon assigned">
                            <i class="fas fa-clipboard-list"></i>
                        </div>
                        <div class="stat-number">8</div>
                        <div class="stat-label trans" data-key="stat_assigned">Assigned Tasks</div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon progress">
                            <i class="fas fa-spinner"></i>
                        </div>
                        <div class="stat-number">3</div>
                        <div class="stat-label trans" data-key="stat_in_progress">In Progress</div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon completed">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="stat-number">15</div>
                        <div class="stat-label trans" data-key="stat_completed">Completed Today</div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon overdue">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="stat-number">1</div>
                        <div class="stat-label trans" data-key="stat_overdue">Overdue</div>
                    </div>
                </div>

                <!-- My Tasks -->
                <div class="my-tasks">
                    <div class="tasks-header">
                        <h2 class="trans" data-key="title_department">Department Complaints</h2>
                        <span id="tasksCount">Loading...</span>
                    </div>
                    <div class="tasks-content" id="mainContent">
                        <!-- Complaints will be loaded here dynamically via JavaScript -->
                        <div style="padding: 40px; text-align: center; color: #666;">
                            <i class="fas fa-spinner fa-spin" style="font-size: 3rem; margin-bottom: 15px;"></i>
                            <p style="font-size: 1.1rem;">Loading complaints...</p>
                        </div>
                    </div>
                </div>

                <!-- Work Progress -->
                <div class="work-progress">
                    <div class="progress-header">
                        <h3>Work Progress</h3>
                        <span>Performance Metrics</span>
                    </div>
                    
                    <div class="progress-item">
                        <div class="progress-label">
                            <span>Daily Target</span>
                            <span>12/15 tasks</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill daily" style="width: 80%;"></div>
                        </div>
                    </div>
                    
                    <div class="progress-item">
                        <div class="progress-label">
                            <span>Weekly Target</span>
                            <span>68/75 tasks</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill weekly" style="width: 91%;"></div>
                        </div>
                    </div>
                    
                    <div class="progress-item">
                        <div class="progress-label">
                            <span>Monthly Target</span>
                            <span>245/300 tasks</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill monthly" style="width: 82%;"></div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="quick-actions">
                    <div class="action-card" onclick="reportIssue()">
                        <div class="action-icon">
                            <i class="fas fa-exclamation-circle"></i>
                        </div>
                        <div class="action-title">Reported Issues</div>
                        <div class="action-description">Report problems or obstacles</div>
                    </div>
                    
                    <div class="action-card" onclick="requestSupport()">
                        <div class="action-icon">
                            <i class="fas fa-hands-helping"></i>
                        </div>
                        <div class="action-title">Requested Support</div>
                        <div class="action-description">Make Sure they Get help from supervisors</div>
                    </div>
                    
                    <div class="action-card" onclick="updateLocation()">
                        <div class="action-icon">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                    
                        <div class="action-description">Share current work location</div>
                    </div>
                    
                    <div class="action-card" onclick="voiceUpdate()">
                        <div class="action-icon">
                            <i class="fas fa-microphone"></i>
                        </div>
                        <div class="action-title">Voice Update</div>
                        <div class="action-description">Record progress update</div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Worker Management Modal -->
    <div id="workerModal" class="worker-modal" style="display: none;">
        <div class="worker-modal-overlay" onclick="closeWorkerModal()"></div>
        <div class="worker-modal-content">
            <div class="worker-modal-header">
                <h2><i class="fas fa-users"></i> Worker Management</h2>
                <button class="close-modal-btn" onclick="closeWorkerModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="worker-modal-body">
                <!-- Add Worker Form -->
                <div class="add-worker-section">
                    <button class="toggle-add-worker-btn" onclick="toggleAddWorkerForm()">
                        <i class="fas fa-plus-circle"></i> Add New Worker
                    </button>

                    <div id="addWorkerForm" class="add-worker-form" style="display: none;">
                        <h3>Add New Worker</h3>
                        <div class="form-grid">
                            <div class="form-group">
                                <label>First Name *</label>
                                <input type="text" id="workerFirstName" placeholder="Enter first name" required>
                            </div>
                            <div class="form-group">
                                <label>Last Name *</label>
                                <input type="text" id="workerLastName" placeholder="Enter last name" required>
                            </div>
                            <div class="form-group">
                                <label>Phone Number *</label>
                                <input type="tel" id="workerPhone" placeholder="Enter phone number" required>
                            </div>
                        </div>
                        <div class="form-actions">
                            <button class="btn-cancel" onclick="toggleAddWorkerForm()">Cancel</button>
                            <button class="btn-submit" onclick="submitNewWorker()">
                                <i class="fas fa-user-plus"></i> Add Worker
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Workers Table -->
                <div class="workers-table-container">
                    <h3>Available Workers</h3>
                    <table class="workers-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Phone Number</th>
                                <th>Assigned Work</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="workersTableBody">
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 2rem;">
                                    <i class="fas fa-spinner fa-spin"></i> Loading workers...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="/official/officialJS/official.profile.js"></script>
</body>
</html>