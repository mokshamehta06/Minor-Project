<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Muncipality Dashboard - Voice Municipal Assistant</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="/official/officialStyles/officialStyles.css" rel="stylesheet">
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <div class="staff-info">
                    <div class="staff-logo">👷</div>
                    <div class="staff-details">
                        <h3 id="staffName"></h3>
                        <p id="staffDept"></p>
                    </div>
                </div>
            </div>
            
                <div class="nav-menu">
                <a href="#my-tasks" class="nav-item active">
                    <i class="fas fa-tasks"></i>
                    <span class="trans" data-key="nav_my_tasks">My Tasks</span>
                </a>
                <a href="#assigned-complaints" class="nav-item">
                    <i class="fas fa-clipboard-list"></i>
                    <span class="trans" data-key="nav_assigned">Assigned Complaints</span>
                </a>
                <a href="#field-updates" class="nav-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <span class="trans" data-key="nav_field_updates">Field Updates</span>
                </a>
                <a href="#work-history" class="nav-item" onclick="showWorkHistory(event)">
                    <i class="fas fa-history"></i>
                    <span class="trans" data-key="nav_work_history">Work History</span>
                </a>
                <a href="#resources" class="nav-item" onclick="showResources(event)">
                    <i class="fas fa-tools"></i>
                    <span class="trans" data-key="nav_resources">Resources</span>
                </a>
                <a href="#voice-reports" class="nav-item" onclick="showVoiceReports(event)">
                    <i class="fas fa-microphone"></i>
                    <span class="trans" data-key="nav_voice_reports">Voice Reports</span>
                </a>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Header -->
            <header class="header">
                <div class="header-left">
                    <h1>Staff Dashboard</h1>
                </div>
                
                <div class="header-right">
                    <div class="task-counter">
                        <i class="fas fa-tasks"></i>
                        5 Active Tasks
                    </div>
                    
                    <div class="user-profile">
                        <div class="user-avatar">S</div>
                        <span>Staff</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                </div>
            </header>

            <!-- Dashboard Content -->
            <div class="dashboard-content">
                <!-- Quick Stats -->
                <div class="quick-stats">
                    <div class="stat-card">
                        <div class="stat-icon assigned">
                            <i class="fas fa-clipboard-list"></i>
                        </div>
                        <div class="stat-number">8</div>
                        <div class="stat-label trans" data-key="stat_assigned">Assigned Tasks</div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon progress">
                            <i class="fas fa-spinner"></i>
                        </div>
                        <div class="stat-number">3</div>
                        <div class="stat-label trans" data-key="stat_in_progress">In Progress</div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon completed">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="stat-number">15</div>
                        <div class="stat-label trans" data-key="stat_completed">Completed Today</div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon overdue">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="stat-number">1</div>
                        <div class="stat-label trans" data-key="stat_overdue">Overdue</div>
                    </div>
                </div>

                <!-- My Tasks -->
                <div class="my-tasks">
                    <div class="tasks-header">
                        <h2 class="trans" data-key="title_department">Department Complaints</h2>
                        <span id="tasksCount">Loading...</span>
                    </div>
                    <div class="tasks-content" id="mainContent">
                        <!-- Complaints will be loaded here dynamically via JavaScript -->
                        <div style="padding: 40px; text-align: center; color: #666;">
                            <i class="fas fa-spinner fa-spin" style="font-size: 3rem; margin-bottom: 15px;"></i>
                            <p style="font-size: 1.1rem;">Loading complaints...</p>
                        </div>
                    </div>
                </div>

                <!-- Work Progress -->
                <div class="work-progress">
                    <div class="progress-header">
                        <h3>Work Progress</h3>
                        <span>Performance Metrics</span>
                    </div>
                    
                    <div class="progress-item">
                        <div class="progress-label">
                            <span>Daily Target</span>
                            <span>12/15 tasks</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill daily" style="width: 80%;"></div>
                        </div>
                    </div>
                    
                    <div class="progress-item">
                        <div class="progress-label">
                            <span>Weekly Target</span>
                            <span>68/75 tasks</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill weekly" style="width: 91%;"></div>
                        </div>
                    </div>
                    
                    <div class="progress-item">
                        <div class="progress-label">
                            <span>Monthly Target</span>
                            <span>245/300 tasks</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill monthly" style="width: 82%;"></div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="quick-actions">
                    <div class="action-card" onclick="reportIssue()">
                        <div class="action-icon">
                            <i class="fas fa-exclamation-circle"></i>
                        </div>
                        <div class="action-title">Reported Issues</div>
                        <div class="action-description">Report problems or obstacles</div>
                    </div>
                    
                    <div class="action-card" onclick="requestSupport()">
                        <div class="action-icon">
                            <i class="fas fa-hands-helping"></i>
                        </div>
                        <div class="action-title">Requested Support</div>
                        <div class="action-description">Make Sure they Get help from supervisors</div>
                    </div>
                    
                    <div class="action-card" onclick="updateLocation()">
                        <div class="action-icon">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                    
                        <div class="action-description">Share current work location</div>
                    </div>
                    
                    <div class="action-card" onclick="voiceUpdate()">
                        <div class="action-icon">
                            <i class="fas fa-microphone"></i>
                        </div>
                        <div class="action-title">Voice Update</div>
                        <div class="action-description">Record progress update</div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Worker Management Modal -->
    <div id="workerModal" class="worker-modal" style="display: none;">
        <div class="worker-modal-overlay" onclick="closeWorkerModal()"></div>
        <div class="worker-modal-content">
            <div class="worker-modal-header">
                <h2><i class="fas fa-users"></i> Worker Management</h2>
                <button class="close-modal-btn" onclick="closeWorkerModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="worker-modal-body">
                <!-- Add Worker Form -->
                <div class="add-worker-section">
                    <button class="toggle-add-worker-btn" onclick="toggleAddWorkerForm()">
                        <i class="fas fa-plus-circle"></i> Add New Worker
                    </button>

                    <div id="addWorkerForm" class="add-worker-form" style="display: none;">
                        <h3>Add New Worker</h3>
                        <div class="form-grid">
                            <div class="form-group">
                                <label>First Name *</label>
                                <input type="text" id="workerFirstName" placeholder="Enter first name" required>
                            </div>
                            <div class="form-group">
                                <label>Last Name *</label>
                                <input type="text" id="workerLastName" placeholder="Enter last name" required>
                            </div>
                            <div class="form-group">
                                <label>Phone Number *</label>
                                <input type="tel" id="workerPhone" placeholder="Enter phone number" required>
                            </div>
                        </div>
                        <div class="form-actions">
                            <button class="btn-cancel" onclick="toggleAddWorkerForm()">Cancel</button>
                            <button class="btn-submit" onclick="submitNewWorker()">
                                <i class="fas fa-user-plus"></i> Add Worker
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Workers Table -->
                <div class="workers-table-container">
                    <h3>Available Workers</h3>
                    <table class="workers-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Phone Number</th>
                                <th>Assigned Work</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="workersTableBody">
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 2rem;">
                                    <i class="fas fa-spinner fa-spin"></i> Loading workers...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Work History Modal -->
    <div id="work-history-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content" style="max-width: 800px; max-height: 80vh; overflow-y: auto;">
            <span class="close-btn" onclick="closeWorkHistoryModal()">&times;</span>
            <h2 style="margin-bottom: 1.5rem; color: #1e3a8a;">
                <i class="fas fa-history"></i> Worker Assignment History
            </h2>
            <div id="work-history-content">
                <div style="text-align: center; padding: 2rem; color: #64748b;">
                    <i class="fas fa-spinner fa-spin" style="font-size: 2rem;"></i>
                    <p>Loading history...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Resources Modal -->
    <div id="resources-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content" style="max-width: 700px;">
            <span class="close-btn" onclick="closeResourcesModal()">&times;</span>
            <h2 style="margin-bottom: 1.5rem; color: #1e3a8a;">
                <i class="fas fa-tools"></i> Resources & Tools
            </h2>
            <div style="display: grid; gap: 1rem;">
                <div style="background: #f0f9ff; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #3b82f6;">
                    <h3 style="margin: 0 0 0.5rem 0; color: #1e40af;">
                        <i class="fas fa-book"></i> Department Guidelines
                    </h3>
                    <p style="color: #64748b; margin: 0;">Access standard operating procedures and department policies.</p>
                    <button style="margin-top: 1rem; padding: 0.5rem 1rem; background: #3b82f6; color: white; border: none; border-radius: 6px; cursor: pointer;">
                        View Guidelines
                    </button>
                </div>
                <div style="background: #f0fdf4; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #10b981;">
                    <h3 style="margin: 0 0 0.5rem 0; color: #065f46;">
                        <i class="fas fa-phone"></i> Emergency Contacts
                    </h3>
                    <p style="color: #64748b; margin: 0;">Quick access to supervisor and emergency contact numbers.</p>
                    <button style="margin-top: 1rem; padding: 0.5rem 1rem; background: #10b981; color: white; border: none; border-radius: 6px; cursor: pointer;">
                        View Contacts
                    </button>
                </div>
                <div style="background: #fef3c7; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #f59e0b;">
                    <h3 style="margin: 0 0 0.5rem 0; color: #92400e;">
                        <i class="fas fa-wrench"></i> Equipment Checklist
                    </h3>
                    <p style="color: #64748b; margin: 0;">Standard equipment and tools required for field work.</p>
                    <button style="margin-top: 1rem; padding: 0.5rem 1rem; background: #f59e0b; color: white; border: none; border-radius: 6px; cursor: pointer;">
                        View Checklist
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- API Logs Modal - All User Interactions -->
    <div id="voice-reports-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content" style="max-width: 1200px; max-height: 90vh; overflow: hidden;">
            <span class="close-btn" onclick="closeVoiceReportsModal()">&times;</span>
            <h2 style="margin-bottom: 1rem; color: #1e3a8a;">
                <i class="fas fa-server"></i> User API Interactions & Logs
            </h2>
            <p style="color: #64748b; margin-bottom: 1rem; font-size: 0.95rem;">
                View all user interactions with the system - API calls, requests, responses, and logs
            </p>

            <!-- Filters -->
            <div style="display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;">
                <select id="filter-user-type" onchange="filterApiLogs()" style="padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px;">
                    <option value="">All User Types</option>
                    <option value="citizen">Citizens</option>
                    <option value="official">Officials</option>
                    <option value="guest">Guests</option>
                </select>
                <select id="filter-endpoint" onchange="filterApiLogs()" style="padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px;">
                    <option value="">All Endpoints</option>
                    <option value="/api/chat">Chat API</option>
                    <option value="/complaints">Complaints</option>
                    <option value="/user">User Actions</option>
                    <option value="/official">Official Actions</option>
                </select>
                <button onclick="loadApiLogs()" style="padding: 0.5rem 1rem; background: #3b82f6; color: white; border: none; border-radius: 6px; cursor: pointer;">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
            </div>

            <!-- Stats Summary -->
            <div id="api-stats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
                <!-- Stats will be loaded here -->
            </div>

            <div id="voice-reports-content" style="max-height: 60vh; overflow-y: auto;">
                <div style="text-align: center; padding: 2rem; color: #64748b;">
                    <i class="fas fa-spinner fa-spin" style="font-size: 2rem;"></i>
                    <p>Loading API logs...</p>
                </div>
            </div>
        </div>
    </div>

    <script src="/official/officialJS/official.profile.js"></script>
</body>
</html>