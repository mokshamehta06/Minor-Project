<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us - Civic Portal</title>
    <link rel="stylesheet" href="/landing/style.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>

    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="logo">
                <i class="fas fa-city"></i>
                <h1>WELCOME TO PORTAL</h1>
            </div>
            <nav class="nav">
                <a href="/" class="nav-link">Home</a>
                <a href="/services" class="nav-link">Services</a>
                <a href="/about" class="nav-link active">About</a>
                <a href="/contact" class="nav-link">Contact</a>
            </nav>
        </div>
    </header>

    <!-- User Type Selection -->
    <section class="user-selection" id="userSelection">
        <div class="container">
            <div class="selection-header">
                <h2>About Civic Portal</h2>
                <p>Transforming government services through digital innovation and citizen engagement</p>
            </div>

            <div class="user-cards">
                <!-- MISSION -->
                <div class="user-card" id="missionCard">
                    <div class="card-icon">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <h3>Our Mission</h3>
                    <p>To revolutionize how citizens interact with municipal governments through technology</p>

                    <div class="card-features">
                        <span><i class="fas fa-check"></i> Digital Transformation</span>
                        <span><i class="fas fa-check"></i> Transparency</span>
                        <span><i class="fas fa-check"></i> Accessibility</span>
                        <span><i class="fas fa-check"></i> Innovation</span>
                    </div>
                </div>

                <!-- VISION -->
                <div class="user-card" id="visionCard">
                    <div class="card-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <h3>Our Vision</h3>
                    <p>Creating a transparent, efficient, and accessible platform for all citizens</p>

                    <div class="card-features">
                        <span><i class="fas fa-check"></i> Citizen Empowerment</span>
                        <span><i class="fas fa-check"></i> Quality Services</span>
                        <span><i class="fas fa-check"></i> Real-time Solutions</span>
                        <span><i class="fas fa-check"></i> Community Impact</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
        <div class="container">
            <div class="section-header">
                <h2>Our Core Values</h2>
                <p>What drives us and defines our commitment</p>
            </div>

            <div class="features-grid">

                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-eye-slash"></i>
                    </div>
                    <h3>Transparency</h3>
                    <p>Complete transparency in all processes ensuring citizens can track their issues in real-time</p>
                    <ul class="feature-list">
                        <li>Open communication</li>
                        <li>Real-time tracking</li>
                        <li>Status updates</li>
                        <li>Data accessibility</li>
                    </ul>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-universal-access"></i>
                    </div>
                    <h3>Accessibility</h3>
                    <p>Platform designed to be accessible to all citizens regardless of technical expertise</p>
                    <ul class="feature-list">
                        <li>Easy to use</li>
                        <li>Multi-language</li>
                        <li>Voice support</li>
                        <li>Mobile friendly</li>
                    </ul>
                </div>

                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-lightbulb"></i>
                    </div>
                    <h3>Innovation</h3>
                    <p>Continuously innovating and integrating cutting-edge technologies for better services</p>
                    <ul class="feature-list">
                        <li>AI technology</li>
                        <li>Real-time analytics</li>
                        <li>Cloud solutions</li>
                        <li>Automation</li>
                    </ul>
                </div>

            </div>
        </div>
    </section>

    <!-- Voice Assistant Widget -->
    <div class="voice-assistant-widget" id="voiceAssistant">
        <div class="voice-header" onclick="toggleVoiceAssistant()">
            <i class="fas fa-microphone"></i>
            <span>Voice Assistant</span>
            <i class="fas fa-chevron-up" id="voiceToggle"></i>
        </div>

        <div class="voice-body" id="voiceBody">
            <div class="voice-status">
                <div class="status-indicator" id="statusIndicator">
                    <i class="fas fa-microphone-slash"></i>
                    <span id="voiceStatus">Click to activate voice assistant</span>
                </div>
            </div>

            <div class="voice-transcript" id="voiceTranscript">
                <div class="transcript-header">
                    <i class="fas fa-comment-dots"></i>
                    <span>Live Transcript</span>
                </div>
                <div class="transcript-content" id="transcriptContent">
                    <p class="placeholder-text">Voice transcript will appear here...</p>
                </div>
            </div>

            <div class="voice-commands">
                <div class="commands-header">
                    <i class="fas fa-list"></i>
                    <span>Try saying:</span>
                </div>
                <div class="command-list">
                    <span class="command-item">"Tell me about portal"</span>
                    <span class="command-item">"What are your values"</span>
                    <span class="command-item">"Show me features"</span>
                    <span class="command-item">"Help me get started"</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Chatbot -->
    <div class="chatbot" id="chatbot">
        <div class="chatbot-header" onclick="toggleChatbot()">
            <i class="fas fa-comments"></i>
            <span>Chat Support</span>
            <i class="fas fa-chevron-up" id="chatbotToggle"></i>
        </div>

        <div class="chatbot-body" id="chatbotBody">
            <div class="chat-messages" id="chatMessages">
                <div class="message bot-message">
                    <i class="fas fa-robot"></i>
                    <span>Hello! How can I help you today?</span>
                </div>
            </div>

            <div class="chat-input">
                <input type="text" id="chatInput" placeholder="Type your message...">
                <button onclick="sendMessage()"><i class="fas fa-paper-plane"></i></button>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section"> 
                    <h4>Digital Government</h4>
                    <p>Empowering citizens through digital transformation</p>
                </div>

                <div class="footer-section">
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a href="/services">Services</a></li>
                        <li><a href="/about">About</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h4>Contact</h4>
                    <p>support@civicportal.gov</p>
                    <p>1-800-GOV-HELP</p>
                </div>
            </div>
        </div>
    </footer>
    <script src="/landing/script.js"></script>
</body>
</html>
