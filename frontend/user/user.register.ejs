        '700007': { city: 'Kolkata', state: 'West Bengal' },
        '700008': { city: 'Kolkata', state: 'West Bengal' },
        '700009': { city: 'Kolkata', state: 'West Bengal' },
        '700010': { city: 'Kolkata', state: 'West Bengal' },
    };

    function validatePasswordStrengthReg(password) {
        const requirements = {
            length: password.length >= 8,
            uppercase: /[A-Z]/.test(password),
            lowercase: /[a-z]/.test(password),
            number: /\d/.test(password),
            special: /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password)
        };

        // Update requirements UI
        document.getElementById('req-length-reg').classList.toggle('met', requirements.length);
        document.getElementById('req-uppercase-reg').classList.toggle('met', requirements.uppercase);
        document.getElementById('req-lowercase-reg').classList.toggle('met', requirements.lowercase);
        document.getElementById('req-number-reg').classList.toggle('met', requirements.number);
        document.getElementById('req-special-reg').classList.toggle('met', requirements.special);

        const requirementsDiv = document.getElementById('passwordRequirementsReg');
        if (password.length > 0) {
            requirementsDiv.classList.add('show');
        } else {
            requirementsDiv.classList.remove('show');
        }

        // Calculate strength score
        const metCount = Object.values(requirements).filter(Boolean).length;
        let strength = 'Weak';
        let strengthClass = 'weak';

        if (metCount === 5 && password.length >= 12) {
            strength = 'Very Strong';
            strengthClass = 'very-strong';
        } else if (metCount === 5) {
            strength = 'Strong';
            strengthClass = 'strong';
        } else if (metCount === 4 || (metCount === 3 && password.length >= 10)) {
            strength = 'Good';
            strengthClass = 'good';
        } else if (metCount === 3 || metCount === 2) {
            strength = 'Fair';
            strengthClass = 'fair';
        }

        document.getElementById('strengthBarReg').className = 'strength-bar ' + strengthClass;
        document.getElementById('strengthTextReg').textContent = 'Password strength: ' + strength;
    }

    async function fetchCityFromPincode(pincode) {
        const pincodeInput = pincode.trim();
        const pincodeError = document.getElementById('pincodeError');
        const pincodeLoading = document.getElementById('pincodeLoading');

        if (pincodeInput.length === 0) return;

        // Validate pincode format
        if (!/^\d{6}$/.test(pincodeInput)) {
            pincodeError.textContent = 'Please enter a valid 6-digit pincode';
            pincodeError.style.display = 'block';
            document.getElementById('City').value = '';
            document.getElementById('State').value = '';
            return;
        }

        pincodeLoading.style.display = 'block';
        pincodeError.style.display = 'none';

        try {
            // First check local database
            if (pincodeDatabase[pincodeInput]) {
                const cityData = pincodeDatabase[pincodeInput];
                document.getElementById('City').value = cityData.city;
                document.getElementById('State').value = cityData.state;
                pincodeLoading.style.display = 'none';
                pincodeError.style.display = 'none';
                return;
            }

            // If not in local DB, try external API (PostalCodeAPI or similar)
            const response = await fetch(`https://api.zippopotam.us/in/${pincodeInput}`);
            
            if (response.ok) {
                const data = await response.json();
                const city = data.places[0]['place name'] || 'Unknown';
                const state = data.places[0]['state abbreviation'] || 'Unknown';
                document.getElementById('City').value = city;
                document.getElementById('State').value = state;
                pincodeError.style.display = 'none';
            } else {
                pincodeError.textContent = 'Pincode not found. Please enter city and state manually.';
                pincodeError.style.display = 'block';
                document.getElementById('City').value = '';
                document.getElementById('State').value = '';
            }
        } catch (error) {
            console.log('API call failed, using local database or manual entry:', error);
            pincodeError.textContent = 'Unable to fetch city. Please enter manually.';
            pincodeError.style.display = 'block';
            document.getElementById('City').value = '';
            document.getElementById('State').value = '';
        } finally {
            pincodeLoading.style.display = 'none';
        }
    }

    function validateEmail(email) {
        const emailError = document.getElementById('emailError');
        const email_input = email.trim();

        if (email_input.length === 0) {
            emailError.style.display = 'none';
            return true;
        }

        if (!email_input.endsWith('@gmail.com')) {
            emailError.textContent = 'Email must end with @gmail.com';
            emailError.style.display = 'block';
            return false;
        }

        const emailPattern = /^[a-zA-Z0-9._-]+@gmail\.com$/;
        if (!emailPattern.test(email_input)) {
            emailError.textContent = 'Invalid email format';
            emailError.style.display = 'block';
            return false;
        }

        emailError.style.display = 'none';
        return true;
    }

    function validatePhone(phone) {
        const phoneError = document.getElementById('phoneError');
        const phone_input = phone.trim();

        if (phone_input.length === 0) {
            phoneError.style.display = 'none';
            return true;
        }

        if (!/^\d{10}$/.test(phone_input)) {
            phoneError.textContent = 'Phone number must be exactly 10 digits';
            phoneError.style.display = 'block';
            return false;
        }

        phoneError.style.display = 'none';
        return true;
    }

    async function registerDetails() {
        const firstName = document.getElementById('First_name').value.trim();
        const lastName = document.getElementById('Last_name').value.trim();
        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('Password').value.trim();
        const phone = document.getElementById('Phone').value.trim();
        const pincode = document.getElementById('Pincode').value.trim();
        const state = document.getElementById('State').value.trim();
        const city = document.getElementById('City').value.trim();
        const addressLine = document.getElementById('Address_Line').value.trim();

        // Validate email
        if (!validateEmail(email)) {
            alert('Please enter a valid email address ending with @gmail.com');
            return;
        }

        // Validate phone
        if (!validatePhone(phone)) {
            alert('Please enter a valid 10-digit phone number');
            return;
        }

        // Validate password requirements
        const requirements = {
            length: password.length >= 8,
            uppercase: /[A-Z]/.test(password),
            lowercase: /[a-z]/.test(password),
            number: /\d/.test(password),
            special: /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password)
        };

        if (!Object.values(requirements).every(Boolean)) {
            alert('Password does not meet all requirements:\n- At least 8 characters\n- One uppercase letter\n- One lowercase letter\n- One number\n- One special character');
            return;
        }

        if (!pincode || !/^\d{6}$/.test(pincode)) {
            alert('Please enter a valid 6-digit pincode.');
            return;
        }

        if (!city) {
            alert('Please enter a city.');
            return;
        }

        const data = {
            First_name: firstName,
            Last_name: lastName,
            Email: email,
            Password: password,
            Phone: phone,
            Pincode: pincode,
            State: state,
            City: city,
            Address_Line: addressLine
        };

        try{
            const response = await fetch('/user/register', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            console.log('Response from server:', result);

            if(response.ok){
                alert('Registration successful! Please login.');
                window.location.href = '/user/login';
            }else{
                alert('Registration failed: ' + (result.error || 'Unknown error'));
            }
        }catch(error){
            console.error('Error during registration request:', error);
            alert('An error occurred during registration. Please try again.');
        }
    }
</script>
</html>