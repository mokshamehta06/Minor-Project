<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Registration - Municipal Services</title>
    <link rel="stylesheet" href="/styles/common.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .auth-container {
            max-width: 600px;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
        .password-requirements {
            background-color: #f0f0f0;
            padding: 12px;
            border-radius: 5px;
            margin-top: 8px;
            font-size: 13px;
            display: none;
        }

        .password-requirements.show {
            display: block;
        }

        .requirement {
            display: flex;
            align-items: center;
            margin: 6px 0;
            color: #666;
        }

        .requirement-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 20px;
            height: 20px;
            margin-right: 8px;
            border-radius: 50%;
            background-color: #ddd;
            color: white;
            font-size: 12px;
            font-weight: bold;
        }

        .requirement.met {
            color: #28a745;
        }

        .requirement.met .requirement-icon {
            background-color: #28a745;
            content: '✓';
        }

        .password-strength {
            margin-top: 12px;
        }

        .strength-meter {
            width: 100%;
            height: 6px;
            background-color: #e0e0e0;
            border-radius: 3px;
            overflow: hidden;
        }

        .strength-bar {
            height: 100%;
            width: 0%;
            background-color: #dc3545;
            transition: all 0.3s ease;
        }

        .strength-bar.weak {
            width: 20%;
            background-color: #dc3545;
        }

        .strength-bar.fair {
            width: 40%;
            background-color: #ffc107;
        }

        .strength-bar.good {
            width: 60%;
            background-color: #17a2b8;
        }

        .strength-bar.strong {
            width: 80%;
            background-color: #28a745;
        }

        .strength-bar.very-strong {
            width: 100%;
            background-color: #20c997;
        }

        .strength-text {
            font-size: 12px;
            color: #666;
            display: block;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-header">
            <div class="logo-icon">📝</div>
            <h1>User Registration</h1>
            <p>Create your account to access municipal services</p>
        </div>

        <form class="auth-form" onsubmit="event.preventDefault(); registerDetails();">
            <div class="form-row">
                <div class="form-group">
                    <label for="First_name">First Name</label>
                    <input type="text" id="First_name" name="First_name" placeholder="Enter first name" required>
                </div>

                <div class="form-group">
                    <label for="Last_name">Last Name</label>
                    <input type="text" id="Last_name" name="Last_name" placeholder="Enter last name" required>
                </div>
            </div>

            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="Email" placeholder="Enter your email (must end with @gmail.com)" required onblur="validateEmail(this.value)" onkeyup="validateEmail(this.value)">
                <span class="email-error" id="emailError" style="display: none; color: #dc3545; font-size: 12px;"></span>
            </div>

            <div class="form-group">
                <label for="Password">Password</label>
                <input type="password" id="Password" name="Password" placeholder="Create a password (min 6 characters)" required onkeyup="validatePasswordStrengthReg(this.value)">
                <div id="passwordRequirementsReg" class="password-requirements">
                    <div class="requirement" id="req-length-reg">
                        <span class="requirement-icon">✗</span> At least 8 characters
                    </div>
                    <div class="requirement" id="req-uppercase-reg">
                        <span class="requirement-icon">✗</span> One uppercase letter (A-Z)
                    </div>
                    <div class="requirement" id="req-lowercase-reg">
                        <span class="requirement-icon">✗</span> One lowercase letter (a-z)
                    </div>
                    <div class="requirement" id="req-number-reg">
                        <span class="requirement-icon">✗</span> One number (0-9)
                    </div>
                    <div class="requirement" id="req-special-reg">
                        <span class="requirement-icon">✗</span> One special character (!@#$%^&*)
                    </div>
                </div>
                <div class="password-strength">
                    <div class="strength-meter">
                        <div class="strength-bar" id="strengthBarReg"></div>
                    </div>
                    <span class="strength-text" id="strengthTextReg">Password strength: Weak</span>
                </div>
            </div>

            <div class="form-group">
                <label for="Phone">Phone Number</label>
                <input type="tel" id="Phone" name="Phone" placeholder="Enter 10-digit phone number" required onblur="validatePhone(this.value)" onkeyup="validatePhone(this.value)" maxlength="10">
                <span class="phone-error" id="phoneError" style="display: none; color: #dc3545; font-size: 12px;"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="Pincode">Pincode</label>
                    <input type="text" id="Pincode" name="Pincode" placeholder="Enter pincode" required onblur="fetchCityFromPincode(this.value)" pattern="[0-9]{6}" title="Please enter a valid 6-digit pincode">
                    <span class="pincode-loading" id="pincodeLoading" style="display: none; color: #0066cc; font-size: 12px;">Fetching city...</span>
                    <span class="pincode-error" id="pincodeError" style="display: none; color: #dc3545; font-size: 12px;"></span>
                </div>

                <div class="form-group">
                    <label for="City">City</label>
                    <input type="text" id="City" name="City" placeholder="Enter city (auto-filled)" required>
                </div>
            </div>

            <div class="form-group">
                <label for="State">State</label>
                <input type="text" id="State" name="State" placeholder="Enter state" required>
            </div>

            <div class="form-group">
                <label for="Address_Line">Address Line (Optional)</label>
                <input type="text" id="Address_Line" name="Address_Line" placeholder="Enter full address">
            </div>

            <button type="submit" class="btn btn-primary">Register</button>
        </form>

        <div class="auth-footer">
            Already have an account? <a href="/user/login">Login here</a>
        </div>
    </div>
</body>
<script>
